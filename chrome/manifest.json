{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "Nasaq",
  "version": "1.0.0",
  "default_locale": "ar",
  "description": "__MSG_appDescription__",
  "author": "شؤون إسلامية",

  "minimum_chrome_version": "116",

  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "__MSG_cmdOpenPanel__"
    },
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "__MSG_cmdToggleSite__"
    }
  },

  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "content/picker.js",
        "content/overlay.css"
      ],
      "matches": ["<all_urls>"],
      "use_dynamic_url": false
    }
  ]
}
